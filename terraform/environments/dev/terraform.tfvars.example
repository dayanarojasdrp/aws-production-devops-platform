aws_region  = "us-east-1"
environment = "dev"
vpc_cidr    = "10.0.0.0/16"

availability_zones       = ["us-east-1a", "us-east-1b"]
public_subnet_cidrs      = ["10.0.1.0/24", "10.0.2.0/24"]
private_app_subnet_cidrs = ["10.0.11.0/24", "10.0.12.0/24"]
private_db_subnet_cidrs  = ["10.0.21.0/24", "10.0.22.0/24"]

# One NAT reduces cost but makes development outbound access depend on one AZ.
single_nat_gateway = true

alb_ingress_ipv4_cidrs = ["0.0.0.0/0"]
application_port       = 8080
postgres_port          = 5432

database_name                        = "platform"
database_master_username             = "appuser"
database_engine_version              = "16"
database_instance_class              = "db.t4g.micro"
database_allocated_storage           = 20
database_max_allocated_storage       = 50
database_multi_az                    = false
database_backup_retention_days       = 1
database_deletion_protection         = false
database_skip_final_snapshot         = true
database_delete_automated_backups    = true
database_apply_immediately           = true
database_secret_recovery_window_days = 0
database_credentials_version         = 1
