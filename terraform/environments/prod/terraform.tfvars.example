aws_region  = "us-east-1"
environment = "prod"
vpc_cidr    = "10.1.0.0/16"

availability_zones       = ["us-east-1a", "us-east-1b"]
public_subnet_cidrs      = ["10.1.1.0/24", "10.1.2.0/24"]
private_app_subnet_cidrs = ["10.1.11.0/24", "10.1.12.0/24"]
private_db_subnet_cidrs  = ["10.1.21.0/24", "10.1.22.0/24"]

# One NAT per AZ avoids a single-AZ outbound dependency in production.
single_nat_gateway = false

alb_ingress_ipv4_cidrs = ["0.0.0.0/0"]
application_port       = 8080
postgres_port          = 5432

database_name                        = "platform"
database_master_username             = "appuser"
database_engine_version              = "16"
database_instance_class              = "db.t4g.small"
database_allocated_storage           = 50
database_max_allocated_storage       = 200
database_multi_az                    = true
database_backup_retention_days       = 7
database_deletion_protection         = true
database_skip_final_snapshot         = false
database_delete_automated_backups    = false
database_apply_immediately           = false
database_secret_recovery_window_days = 30
database_credentials_version         = 1
